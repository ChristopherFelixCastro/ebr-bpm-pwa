    "db:test:default-versioned-definitions": "npm run db:test:default-versioned-definitions --workspace @ebr-bpm/api",
    "db:test:official-imports": "npm run db:test:official-imports --workspace @ebr-bpm/api",
    "db:test:bpm-guidance": "npm run db:test:bpm-guidance --workspace @ebr-bpm/api",
    "import:official:bpm": "npm run import:official:bpm --workspace @ebr-bpm/api --",
    "import:official:risk": "npm run import:official:risk --workspace @ebr-bpm/api --",
    "bootstrap:universal": "npm run bootstrap:universal --workspace @ebr-bpm/api --",
