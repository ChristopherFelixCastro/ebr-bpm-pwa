  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "jose": "^6.2.12"
  }
