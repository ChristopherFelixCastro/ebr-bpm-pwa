    "db:seed": "npm run db:seed --workspace @ebr-bpm/api --",
    "db:test:constraints": "npm run db:test:constraints --workspace @ebr-bpm/api",
    "db:test:audit": "npm run db:test:audit --workspace @ebr-bpm/api",
    "db:test:catalog": "npm run db:test:catalog --workspace @ebr-bpm/api",
    "db:test:bpm": "npm run db:test:bpm --workspace @ebr-bpm/api",
    "db:test:risk": "npm run db:test:risk --workspace @ebr-bpm/api",
    "db:test:requests": "npm run db:test:requests --workspace @ebr-bpm/api",
    "db:test:assignments": "npm run db:test:assignments --workspace @ebr-bpm/api",
    "db:test:inspections": "npm run db:test:inspections --workspace @ebr-bpm/api",
